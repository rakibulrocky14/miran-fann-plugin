#!/bin/sh
# Starts the Miran Fann MCP server (Claude Code, Cowork, Codex, ZCode).
#
# The engine is a native binary (Apple Silicon Macs, Linux x64 and arm64),
# installed at ~/.miran/bin/miran. When it is missing, or older than the version this
# plugin was released with, this downloads that version's engine package from
# the npm registry, checks it against the SHA-512 pinned below, and installs
# the one binary inside it there; so updating the plugin in your app updates
# the engine too. A newer engine (it updates itself) is used as it is. If a
# download fails and an older engine is installed, that one starts.
#
# KINETIC_BIN overrides the binary; MIRAN_WORKSPACE the folder films are made in.
set -u

ENGINE_VERSION="0.1.6"
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) PKG=miran-darwin-arm64; ENGINE_SHA512="cd55d15253ce793b52eade562a2b97b250f136f1ee0ec9239d47b27ea7b21170c918a3e54d0153b3e909a075601ff490a6664b3887ca99ea8a8c00138f5a40e2" ;;
  Linux-x86_64) PKG=miran-linux-x64; ENGINE_SHA512="fd6ad43336c409b969231a37e8968dbbf50d0cfc97e28040cd573a88fb96c0242d6142ec737c3ec9b33367b509f7b3b9f17039f53a83daabf4d0aa90768bfb6a" ;;
  Linux-aarch64 | Linux-arm64) PKG=miran-linux-arm64; ENGINE_SHA512="048a7fc3b4db47a9c18ac0e8245d207b3b6b0b94db6922618367715779dccbce3a7b7bbd3edaa5440b3cb2851bd4baad136f6d5c2e98eb01b54d661951bcee3c" ;;
  *) PKG=""; ENGINE_SHA512="" ;;
esac
ENGINE_URL="https://registry.npmjs.org/$PKG/-/$PKG-$ENGINE_VERSION.tgz"
# On Linux two big model sets (SAM 2.1, Whisper) come in a package of their
# own, shared with Windows (npm refuses packages much over 150 MB).
MODELS_SHA512="82e39441537e9b23e7ff2fc82d1ca7756df6841716a2579c363101e98ed6848ba9bf1a9e478ca16b946aab76a0520251e36d98622c862f3b699b20a9958f4992"
MODELS_URL="https://registry.npmjs.org/miran-models-onnx/-/miran-models-onnx-$ENGINE_VERSION.tgz"
MIRAN_HOME="$HOME/.miran"
INSTALLED="$MIRAN_HOME/bin/miran"
tmp=""
lock=""

say() {
  echo "miran: $*" >&2
}

cleanup() {
  [ -n "$tmp" ] && rm -rf "$tmp"
  [ -n "$lock" ] && rmdir "$lock" 2>/dev/null
  tmp=""
  lock=""
  return 0
}
trap cleanup EXIT

# The version an engine reports ("Miran Fann 0.1.4"), or nothing.
version_of() {
  "$1" --version 2>/dev/null | awk 'NR == 1 { print $NF }'
}

# True when version $1 is older than $2 (numbers, X.Y.Z).
older() {
  awk -v a="$1" -v b="$2" 'BEGIN {
    split(a, x, "."); split(b, y, ".")
    for (i = 1; i <= 3; i++) { if (x[i] + 0 < y[i] + 0) exit 0; if (x[i] + 0 > y[i] + 0) exit 1 }
    exit 1
  }'
}

# The installed engine is missing or older than this plugin's.
needs_engine() {
  [ -x "$INSTALLED" ] || return 0
  have="$(version_of "$INSTALLED")"
  [ -z "$have" ] || older "$have" "$ENGINE_VERSION"
}

# Download, check and install this plugin's engine. Returns non-zero (and
# installs nothing) when any step fails.
install_engine() {
  if [ -z "$PKG" ] || [ -z "$ENGINE_SHA512" ]; then
    say "this plugin has no Miran Fann engine for $(uname -s) $(uname -m) (Apple Silicon Macs, Linux x64 and arm64; on Windows run: npx miran-fann setup)."
    return 1
  fi
  mkdir -p "$MIRAN_HOME/bin" "$MIRAN_HOME/cache" || { say "could not create $MIRAN_HOME"; return 1; }
  # One download at a time: a second start waits for the first (or, with an
  # engine already there, starts that one).
  waited=0
  until mkdir "$MIRAN_HOME/cache/engine-install.lock" 2>/dev/null; do
    [ -x "$INSTALLED" ] && return 0
    waited=$((waited + 1))
    if [ "$waited" -gt 300 ]; then
      rmdir "$MIRAN_HOME/cache/engine-install.lock" 2>/dev/null
      waited=0
    fi
    sleep 1
  done
  lock="$MIRAN_HOME/cache/engine-install.lock"
  needs_engine || { cleanup; return 0; }
  tmp="$(mktemp -d "$MIRAN_HOME/cache/engine.XXXXXX")" || { say "could not create a temporary folder"; cleanup; return 1; }
  say "downloading the Miran Fann engine $ENGINE_VERSION and its models from the npm registry (150 to 260 MB, once)"
  if ! curl -fsSL --retry 3 --connect-timeout 15 -o "$tmp/engine.tgz" "$ENGINE_URL"; then
    say "could not download the engine from $ENGINE_URL"
    cleanup
    return 1
  fi
  if command -v sha512sum >/dev/null 2>&1; then
    got="$(sha512sum "$tmp/engine.tgz" | cut -d ' ' -f 1)"
  else
    got="$(shasum -a 512 "$tmp/engine.tgz" | cut -d ' ' -f 1)"
  fi
  if [ "$got" != "$ENGINE_SHA512" ]; then
    say "the downloaded engine does not match the SHA-512 pinned in this plugin; nothing was installed"
    cleanup
    return 1
  fi
  if ! tar -xzf "$tmp/engine.tgz" -C "$tmp" package/bin/miran package/models; then
    say "could not unpack the engine"
    cleanup
    return 1
  fi
  chmod 755 "$tmp/package/bin/miran"
  # A rename: sessions running the old engine keep their copy.
  if ! mv -f "$tmp/package/bin/miran" "$INSTALLED"; then
    say "could not install the engine to $INSTALLED"
    cleanup
    return 1
  fi
  say "installed the engine $ENGINE_VERSION to $INSTALLED"
  # Its models (all but the voice), checked file by file against their pins.
  set_folders "$tmp/package/models"
  "$INSTALLED" models install "$tmp/package/models" >/dev/null 2>&1 || say "the models did not install; they will download when first needed"
  case "$PKG" in miran-linux-*) install_shared_models ;; esac
  cleanup
  return 0
}

# miran-darwin-arm64 0.1.5 was packed without its set folders (macOS cp copied
# each folder's contents); `models install` looks for <set>/<file>.
set_folders() {
  [ -d "$1/sam2.1-small" ] && return 0
  for f in "$1"/*; do
    case "${f##*/}" in
      SAM2_1Small*.mlpackage) s=sam2.1-small ;;
      DepthAnythingV2Small*.mlpackage) s=depth-v2-small ;;
      DeepFilterNet3_onnx.tar.gz) s=deepfilternet3 ;;
      *) continue ;;
    esac
    mkdir -p "$1/$s" && mv "$f" "$1/$s/"
  done
}

# Linux: the shared model package, checked against its own pin. A failure
# leaves the engine working; those models then download when first needed.
install_shared_models() {
  [ -n "$MODELS_SHA512" ] || return 0
  if ! curl -fsSL --retry 3 --connect-timeout 15 -o "$tmp/models.tgz" "$MODELS_URL"; then
    say "could not download $MODELS_URL; cutouts and transcripts will download their models when first used"
    return 0
  fi
  if command -v sha512sum >/dev/null 2>&1; then
    got="$(sha512sum "$tmp/models.tgz" | cut -d ' ' -f 1)"
  else
    got="$(shasum -a 512 "$tmp/models.tgz" | cut -d ' ' -f 1)"
  fi
  if [ "$got" != "$MODELS_SHA512" ]; then
    say "the downloaded models do not match the SHA-512 pinned in this plugin; they were not installed"
    return 0
  fi
  mkdir -p "$tmp/shared" && tar -xzf "$tmp/models.tgz" -C "$tmp/shared" package/models \
    && "$INSTALLED" models install "$tmp/shared/package/models" >/dev/null 2>&1 \
    || say "the shared models did not install; they will download when first needed"
}

ENGINE=""
if [ -n "${KINETIC_BIN:-}" ] && [ -x "$KINETIC_BIN" ]; then
  ENGINE="$KINETIC_BIN"
elif [ -x "$INSTALLED" ] || [ ! -x "$HOME/.cargo/bin/kinetic" ]; then
  if needs_engine; then
    install_engine || [ -x "$INSTALLED" ] || exit 1
  fi
  ENGINE="$INSTALLED"
else
  ENGINE="$HOME/.cargo/bin/kinetic"
fi
cleanup
trap - EXIT

# Films are made in the agent's working folder: with no workspace named
# here the engine asks the client for its roots first, and only then falls
# back to its own folder (~/miran-work from the home folder). Never pin
# $PWD here: GUI hosts often start in $HOME itself.
if [ -n "${MIRAN_WORKSPACE:-}" ]; then
  exec "$ENGINE" mcp --workspace "$MIRAN_WORKSPACE" "$@"
elif [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
  exec "$ENGINE" mcp --workspace "$CLAUDE_PROJECT_DIR" "$@"
else
  exec "$ENGINE" mcp "$@"
fi
